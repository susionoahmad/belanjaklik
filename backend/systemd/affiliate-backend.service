[Unit]
Description=BelanjaKlik Affiliate Marketplace High-Performance Go Backend API
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/var/www/belanjaklik
ExecStart=/var/www/belanjaklik/belanjaklik-backend

# Environment Variables
Environment="PORT=8080"
Environment="DB_PATH=/var/www/belanjaklik/katalog.db"
Environment="GIN_MODE=release"

# Auto-Restart Configuration
Restart=always
RestartSec=5s

# Memory Safety & Resource Limits (Crucial for GCP e2-micro 1GB RAM)
MemoryHigh=100M
MemoryMax=150M
CPUQuota=80%

# Security & Sandboxing
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=affiliate-backend

[Install]
WantedBy=multi-user.target
